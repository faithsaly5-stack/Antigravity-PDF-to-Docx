# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Virtual Environments
.venv/
venv/
env/
ENV/

# IDE & Editors
.idea/
.vscode/
*.swp
*.swo

# OCR Pipeline Caches & Temp Files
page_cache/
temp_page.md

# Output documents & test results
output_*.docx
output_*.pdf
*.log
dump.txt

# Credentials, Secrets & Tokens (100% Protection)
.env
*.env
.env.*
secrets.*
credentials.*
*.pem
*.key
*.token

# User input files & generated PDFs (prevent leaking user books)
*.pdf
!samples/*.pdf

# Antigravity runtime state (keep skills tracked for deployment)
.agents/*
!.agents/skills/
!.agents/skills/**
